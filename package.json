{
  "name": "singularity",
  "version": "1.0.0",
  "private": true,
  "description": "Five players, one body: a chaotic online co-op physics party game in the browser.",
  "license": "MIT",
  "author": "Sankalp H S",
  "homepage": "https://github.com/Aryabhatta-0/singularity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aryabhatta-0/singularity.git"
  },
  "bugs": {
    "url": "https://github.com/Aryabhatta-0/singularity/issues"
  },
  "keywords": [
    "game",
    "multiplayer",
    "physics",
    "co-op",
    "party-game",
    "spacetimedb",
    "rapier",
    "threejs",
    "nextjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "host": "node scripts/host.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "esbuild tests/all.test.mjs --bundle --platform=node --format=esm --outfile=.test-dist/all.test.mjs && node --test --test-isolation=none .test-dist/all.test.mjs",
    "test:browser": "python tests/browser/playwright_regression.py",
    "test:load": "locust --config tests/load/locust.conf",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bindings": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path server --yes",
    "db:local": "node scripts/local-db.mjs",
    "db:publish:maincloud": "spacetime publish singularity --module-path server --server maincloud --delete-data=never",
    "e2e:room": "node scripts/run-e2e.mjs room",
    "e2e:leaderboard": "node scripts/run-e2e.mjs leaderboard",
    "e2e:online": "esbuild scripts/online-smoke.ts --bundle --platform=node --format=esm --outfile=.test-dist/online-smoke.mjs --log-level=warning && node .test-dist/online-smoke.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@types/three": "^0.185.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "spacetimedb": "2.10.*",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
