{
  "name": "singularity",
  "version": "1.0.0",
  "private": true,
  "description": "Five players, one body: a chaotic co-op physics party game you host from your own machine.",
  "license": "MIT",
  "author": "Sankalp H S",
  "homepage": "https://github.com/Aryabhatta-0/singularity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aryabhatta-0/singularity.git"
  },
  "bugs": {
    "url": "https://github.com/Aryabhatta-0/singularity/issues"
  },
  "keywords": [
    "game",
    "multiplayer",
    "physics",
    "co-op",
    "party-game",
    "spacetimedb",
    "rapier",
    "threejs",
    "nextjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "host": "node scripts/host.mjs",
    "build": "next build",
    "start": "next start -p 3001",
    "test": "esbuild tests/all.test.mjs --bundle --platform=node --format=esm --outfile=.test-dist/all.test.mjs && node --test --test-isolation=none .test-dist/all.test.mjs",
    "test:browser": "python tests/browser/playwright_regression.py",
    "test:load": "locust --config tests/load/locust.conf",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "bindings": "spacetime generate --lang typescript --out-dir src/room_bindings --module-path room-server --yes && spacetime generate --lang typescript --out-dir src/leaderboard_bindings --module-path leaderboard-server --yes",
    "room:publish": "spacetime publish singularity-room --module-path room-server --server local --delete-data=always --yes",
    "leaderboard:publish": "spacetime publish singularity --module-path leaderboard-server --server local --delete-data=never --yes",
    "e2e:room": "esbuild scripts/room-e2e.ts --bundle --platform=node --format=esm --outfile=.test-dist/room-e2e.mjs && node .test-dist/room-e2e.mjs",
    "e2e:leaderboard": "esbuild scripts/leaderboard-e2e.ts --bundle --platform=node --format=esm --outfile=.test-dist/leaderboard-e2e.mjs && node .test-dist/leaderboard-e2e.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@types/three": "^0.185.4",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "spacetimedb": "2.10.*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
