# Local development needs none of this: `npm run host` (or `npm run dev` after
# `npm run db:local`) runs everything on this machine, generates a session key
# under .singularity/ and points the game at the local SpacetimeDB.
#
# These are for a hosted deployment such as Vercel. Copy to .env.local only if
# you want to point a local build at hosted services.

# ---- Public (NEXT_PUBLIC_*: baked into the browser bundle, never secret) ----

# SpacetimeDB the game connects to. Unset: the machine that served the page,
# port 3000 (self-hosting). Production: wss://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com

# Database name (default: singularity).
# NEXT_PUBLIC_SPACETIMEDB_DATABASE=singularity

# Canonical site URL for metadata, sitemap and social cards.
# NEXT_PUBLIC_SITE_URL=https://singularity-coral.vercel.app

# ---- Server only (never prefix with NEXT_PUBLIC_, never commit) ----

# The site's own origin. SpacetimeDB fetches /.well-known/openid-configuration
# from here to verify game sessions, so it must be publicly reachable and must
# match what the database was told with `configure_access`.
# SINGULARITY_SESSION_ISSUER=https://singularity-coral.vercel.app

# ES256 private key (a JWK, as one line of JSON) that signs game sessions.
# SECRET. Generate one with:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(k=>crypto.subtle.exportKey('jwk',k.privateKey)).then(j=>console.log(JSON.stringify(j)))"
# On Vercel the app refuses to issue sessions when this is missing.
# SINGULARITY_SESSION_PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"…","y":"…","d":"…"}
