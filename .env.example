# local SpacetimeDB (`spacetime start`, default 127.0.0.1:3000).

# Next.js client (consumed via src/game/net.ts)
NEXT_PUBLIC_SPACETIMEDB_URI=ws://YOUR_SPACETIMEDB_HOST:PORT
NEXT_PUBLIC_SPACETIMEDB_MODULE=YOUR_DATABASE_NAME

# Server-side HTTP endpoint + database (consumed via src/lib/feedback.ts)
SPACETIMEDB_HTTP_URI=http://YOUR_SPACETIMEDB_HOST:PORT
SPACETIMEDB_MODULE=YOUR_DATABASE_NAME

# Legacy Vite variable names (read as fallbacks via scripts/e2e.ts)
VITE_SPACETIMEDB_URI=ws://YOUR_SPACETIMEDB_HOST:PORT
VITE_SPACETIMEDB_DATABASE=YOUR_DATABASE_NAME

# Node scripts / tests (scripts/e2e.ts reads STDB_* and SPACETIMEDB_*)
STDB_URI=ws://YOUR_SPACETIMEDB_HOST:PORT
STDB_DB=YOUR_DATABASE_NAME
SPACETIMEDB_URI=http://YOUR_SPACETIMEDB_HOST:PORT
SPACETIMEDB_DATABASE=YOUR_DATABASE_NAME

