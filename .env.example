# Local development does not need these values. `npm run host` (or `npm run dev`
# after `npm run db:local`) runs all parts on this computer. It makes a session
# key in .singularity/ and connects the game to the local SpacetimeDB.
#
# These values are for a hosted deployment, for example on Vercel. Copy them to
# .env.local only if you want a local build to use hosted services.

# ---- Public (NEXT_PUBLIC_*: the browser bundle contains them, so they are not secret) ----

# The SpacetimeDB that the game connects to. If you do not set it, the game uses
# port 3000 on the computer that sent the page (self-hosting).
# Production: wss://maincloud.spacetimedb.com
# NEXT_PUBLIC_SPACETIMEDB_URI=wss://maincloud.spacetimedb.com

# The database name (default: singularity).
# NEXT_PUBLIC_SPACETIMEDB_DATABASE=singularity

# The main site URL for metadata, the sitemap and social cards.
# NEXT_PUBLIC_SITE_URL=https://singularity-coral.vercel.app

# ---- Server only (do not add the NEXT_PUBLIC_ prefix, do not commit) ----

# The public address of this site. SpacetimeDB gets
# /.well-known/openid-configuration from this address to check game sessions.
# Thus, the address must be public. It must be the same as the address that you
# gave the database with `configure_access`.
# SINGULARITY_SESSION_ISSUER=https://singularity-coral.vercel.app

# The ES256 private key (a JWK, as one line of JSON) that signs game sessions.
# SECRET. To make a key, do this command:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(k=>crypto.subtle.exportKey('jwk',k.privateKey)).then(j=>console.log(JSON.stringify(j)))"
# On Vercel, the app gives no sessions if this key is missing.
# SINGULARITY_SESSION_PRIVATE_KEY={"kty":"EC","crv":"P-256","x":"…","y":"…","d":"…"}
