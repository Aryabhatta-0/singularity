# Everything here is optional — the defaults work for hosting on your network.
#
# Room server (live matches). The host runs it with `npm run host`; by default
# every player connects to SpacetimeDB on the same machine that served the
# page (ws://<page host>:3000). Do NOT pin this to 127.0.0.1: friends' browsers
# would then look for a server on their own machines. Invite links can also
# carry ?server=<address>.
# NEXT_PUBLIC_ROOM_SERVER_URI=ws://192.168.1.20:3000
# NEXT_PUBLIC_ROOM_DATABASE=singularity-room

# Global leaderboard (the only database meant to be hosted publicly). Unset, it
# sits beside the room server. Set it once the leaderboard module is published
# somewhere public, e.g. SpacetimeDB Maincloud:
# NEXT_PUBLIC_LEADERBOARD_URI=wss://maincloud.spacetimedb.com
# NEXT_PUBLIC_LEADERBOARD_DATABASE=singularity
