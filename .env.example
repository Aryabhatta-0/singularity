# local SpacetimeDB (`spacetime start`, default 127.0.0.1:3000).
# The database is permanent local data: publish with `--delete-data=never` so
# republishing the module never wipes rooms or leaderboards.

# Next.js client (consumed via src/game/net.ts)
NEXT_PUBLIC_SPACETIMEDB_URI=ws://YOUR_SPACETIMEDB_HOST:PORT
NEXT_PUBLIC_SPACETIMEDB_MODULE=YOUR_DATABASE_NAME

# Database fallback for the Node E2E script (scripts/e2e.ts reads this after NEXT_PUBLIC_SPACETIMEDB_MODULE)
SPACETIMEDB_MODULE=YOUR_DATABASE_NAME

# Node E2E script (scripts/e2e.ts reads these first)
STDB_URI=ws://YOUR_SPACETIMEDB_HOST:PORT
STDB_DB=YOUR_DATABASE_NAME
